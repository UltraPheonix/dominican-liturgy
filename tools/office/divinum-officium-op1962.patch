diff --git a/web/cgi-bin/horas/specials/psalmi.pl b/web/cgi-bin/horas/specials/psalmi.pl
index 1b9cc089..655fd647 100644
--- a/web/cgi-bin/horas/specials/psalmi.pl
+++ b/web/cgi-bin/horas/specials/psalmi.pl
@@ -117,6 +117,23 @@ sub psalmi_minor {
     if ($hora eq 'Completorium' && $dayofweek == 6 && $winner{Rank} =~ /Dominica/i && $dayname[0] !~ /Nat/) {
       $i = 12;
     }
+
+    # Breviarium S.O.P. (1962), Rubricae generales nn. 150-153: Compline is of Sunday on Sundays and on feasts
+    # of the I and II class (also after I Vespers of a I class feast); after I Vespers of a Sunday it is of
+    # Saturday; otherwise of the current weekday.
+    if ($version =~ /Praedicatorum/ && $hora eq 'Completorium') {
+      # (Sunday's psalms also through Christmastide, in the octaves of Easter and Pentecost, in the Triduum
+      # and on All Souls)
+      our ($month, $day);
+      # (a feria, even a privileged one, keeps the psalms of its weekday)
+      my $feria = $winner{Rank} =~ /Feria|Vigilia|Quattuor|Hebdomad/i && $winner !~ /Pasc0|Pasc7/;
+      my $sundaypsalms = $dayofweek == 0 || ($rank >= 5 && !$feria)
+        || ($month == 12 && $day >= 25) || ($month == 1 && $day <= 13)
+        || $winner =~ /Quad6-[456]/ || $winner =~ /11-02/ || ($month == 11 && $day == 1);
+      $i = $sundaypsalms ? 0 : 2 * $dayofweek;
+      $i = 12 if $dayofweek == 6 && $winner{Rank} =~ /Dominica/i && $dayname[0] !~ /Nat/;
+      $i = 0 if $dayname[0] =~ /^(?:Pasc0|Pasc7)/ || ($dayname[0] =~ /^Pasc1/ && $dayofweek == 6 && $winner =~ /Pasc1-0/);    # the octaves of Easter and Pentecost
+    }
     $ant = chompd($psalmi[$i]);
     $psalms = chompd($psalmi[$i + 1]);
     if (($version =~ /196/ && $psalms =~ /117/ && $laudes == 2) || $rule =~ /Prima=53/i) { $psalms =~ s/117/53/; }
@@ -131,7 +148,7 @@ sub psalmi_minor {
 
     #psalmi dominica rule for completorium
     elsif (($rule =~ /Psalmi\s*(minores)*\s*Dominica/i || $communerule =~ /Psalmi\s*(minores)*\s*Dominica/i)
-      && ($version !~ /1960/ || $rank >= 6))
+      && ($version !~ /1960|Praedicatorum/ || $rank >= 6))
     {
       $ant = chompd($psalmi[0]);
       $psalms = chompd($psalmi[1]);
@@ -471,6 +488,9 @@ sub psalmi_major {
       || ( $version =~ /Trident/i
         && $winner =~ /Sancti/
         && ($hora eq 'Laudes' || $rank >= 2))
+      # Breviarium S.O.P. (1962), nn. 151-152: feasts of the I and II class take Lauds and Vespers
+      # "e Proprio vel Communi"
+      || ($version =~ /Praedicatorum/ && $winner =~ /Sancti/ && $rank >= 5)
     ) {
       ($w, $c) = getproprium("Ant $hora", $lang, 1);
       setbuild2("Antiphona ex $commune") if $w;
@@ -494,6 +514,8 @@ sub psalmi_major {
       (
            $rule =~ /Psalmi Dominica/i
         || ($version =~ /cist/i && (($winner =~ /Sancti/i && $rank >= 2.2) || $antecapitulum))
+        # Breviarium S.O.P. (1962), nn. 151-152: on feasts of the I and II class Lauds take the Sunday psalms
+        || ($version =~ /Praedicatorum/ && $hora eq 'Laudes' && $winner =~ /Sancti/i && $rank >= 5)
         || ($commune{Rule} && $commune{Rule} =~ /Psalmi Dominica/i)
       )
       && @antiphones
